{
  "name": "ecommerce-platform-backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "start:gateway": "nest start api-gateway --watch",
    "start:auth": "nest start auth-service --watch",
    "start:product": "nest start product-service --watch",
    "start:cart": "nest start cart-service --watch",
    "start:orders": "nest start orders-service --watch",
    "start:payments": "nest start payment-service --watch",
    "start:user": "nest start user-service --watch",
    "start:all": "concurrently \"pnpm run start:gateway\" \"pnpm run start:auth\" \"pnpm run start:product\" \"pnpm run start:cart\" \"pnpm run start:orders\" \"pnpm run start:payments\" \"pnpm run start:user\"",
    "build": "nest build",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/apps/ecommerce-platform-backend/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./apps/ecommerce-platform-backend/test/jest-e2e.json",
    "typeorm": "TS_NODE_COMPILER_OPTIONS='{\"module\":\"commonjs\"}' node -r ts-node/register -r tsconfig-paths/register ./node_modules/typeorm/cli.js",
    "mig:gen:auth": "pnpm typeorm migration:generate -d apps/auth-service/src/data-source.ts",
    "mig:create:auth": "pnpm typeorm migration:create",
    "mig:run:auth": "pnpm typeorm migration:run -d apps/auth-service/src/data-source.ts",
    "mig:revert:auth": "pnpm typeorm migration:revert -d apps/auth-service/src/data-source.ts",
    "mig:show:auth": "pnpm typeorm migration:show -d apps/auth-service/src/data-source.ts",
    "mig:gen:product": "pnpm typeorm migration:generate -d apps/product-service/src/data-source.ts",
    "mig:create:product": "pnpm typeorm migration:create",
    "mig:run:product": "pnpm typeorm migration:run -d apps/product-service/src/data-source.ts",
    "mig:revert:product": "pnpm typeorm migration:revert -d apps/product-service/src/data-source.ts",
    "mig:show:product": "pnpm typeorm migration:show -d apps/product-service/src/data-source.ts",
    "mig:gen:cart": "pnpm typeorm migration:generate -d apps/cart-service/src/data-source.ts",
    "mig:create:cart": "pnpm typeorm migration:create",
    "mig:run:cart": "pnpm typeorm migration:run -d apps/cart-service/src/data-source.ts",
    "mig:revert:cart": "pnpm typeorm migration:revert -d apps/cart-service/src/data-source.ts",
    "mig:show:cart": "pnpm typeorm migration:show -d apps/cart-service/src/data-source.ts",
    "mig:gen:order": "pnpm typeorm migration:generate -d apps/orders-service/src/data-source.ts",
    "mig:create:order": "pnpm typeorm migration:create",
    "mig:run:order": "pnpm typeorm migration:run -d apps/orders-service/src/data-source.ts",
    "mig:revert:order": "pnpm typeorm migration:revert -d apps/orders-service/src/data-source.ts",
    "mig:show:order": "pnpm typeorm migration:show -d apps/orders-service/src/data-source.ts",
    "mig:gen:user": "pnpm typeorm migration:generate -d apps/user-service/src/data-source.ts",
    "mig:create:user": "pnpm typeorm migration:create",
    "mig:run:user": "pnpm typeorm migration:run -d apps/user-service/src/data-source.ts",
    "mig:revert:user": "pnpm typeorm migration:revert -d apps/user-service/src/data-source.ts",
    "mig:show:user": "pnpm typeorm migration:show -d apps/user-service/src/data-source.ts"
  },
  "dependencies": {
    "@nestjs-modules/ioredis": "^2.2.1",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mapped-types": "*",
    "@nestjs/microservices": "^11.1.17",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.20.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "slugify": "^1.6.8",
    "stripe": "^22.1.1",
    "typeorm": "^0.3.28",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.7",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/supertest": "^6.0.2",
    "concurrently": "^9.2.1",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/apps/",
      "<rootDir>/libs/"
    ],
    "moduleNameMapper": {
      "^@app/common(|/.*)$": "<rootDir>/libs/common/src/$1"
    }
  }
}
